<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    groupId 는 옛 배포와 같은 ai.bareun.tagger 다.

    상위 네임스페이스 ai.bareun 은 Maven Central Portal 에서 신청이 거부된다
    ("Namespace 'ai.bareun' cannot be used"). 하위 ai.bareun.tagger 가 이미
    등록돼 있어 충돌하기 때문이다. 그 네임스페이스는 2023 년에 검증을 마쳤고
    ai.bareun.tagger:bareun:1.4.3 이 그것으로 배포됐다.

    artifactId 는 bareun-client 로 둔다. 옛 bareun(1.4.3, gRPC 기반)과 좌표가
    갈려야 사용자가 섞어 쓰지 않는다.

    ai.bareun 은 Sonatype 지원에 문의 중이다. 열리면 그때 옮긴다 —
    자바 패키지 이름(ai.bareun.client 등)은 groupId 와 무관하므로 코드는
    그대로 두면 된다.
  -->
  <groupId>ai.bareun.tagger</groupId>
  <artifactId>bareun-client</artifactId>
  <version>2.0.0</version>
  <packaging>jar</packaging>

  <name>bareun-client</name>
  <description>Java client for bareun Korean NLP (Connect RPC)</description>
  <url>https://github.com/bareun-nlp/bareun-java</url>

  <licenses>
    <license>
      <name>BSD 3-Clause</name>
      <url>https://opensource.org/licenses/BSD-3-Clause</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Gihyun YUN</name>
      <email>gih2yun@baikal.ai</email>
      <organization>BAIKAL AI Inc.</organization>
      <organizationUrl>https://bareun.ai</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/bareun-nlp/bareun-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/bareun-nlp/bareun-java.git</developerConnection>
    <url>https://github.com/bareun-nlp/bareun-java</url>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <protobuf.version>3.25.5</protobuf.version>
    <junit.version>5.11.3</junit.version>
  </properties>

  <dependencies>
    <!--
      런타임 의존은 protobuf-java 하나뿐이다.

      Connect 의 단항(unary) 호출은 `POST /<패키지>.<서비스>/<메서드>` 에 메시지를
      그대로 실어 보내는 평범한 HTTP 다. 그래서 전송에는 JDK 11+ 의
      java.net.http.HttpClient 를 쓰고, gRPC 스택(grpc-netty-shaded·guava·
      opencensus 등 20여 개)을 통째로 들이지 않는다. 옛 버전은 2019 년 gRPC
      1.21.0 에 묶여 있었고 그 이행 의존이 계속 문제였다.
    -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <!-- JSON 오류 본문과 application/json 경로에만 쓴다. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <version>${protobuf.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <!--
            서비스 스텁(protoc-gen-grpc-java)은 만들지 않는다. Connect 호출은
            ConnectClient 가 경로 문자열로 직접 부르므로 메시지 클래스만 있으면 된다.
          -->
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.1</version>
        <configuration>
          <doclint>none</doclint>
          <!-- 주석이 한국어라 인코딩을 명시하지 않으면 빌드 환경에 따라 깨진다. -->
          <charset>UTF-8</charset>
          <docencoding>UTF-8</docencoding>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Maven Central 배포.

      옛 pom 은 s01.oss.sonatype.org(OSSRH)로 올리게 돼 있었는데 그 창구는 닫혔다.
      지금은 Central Portal(central.sonatype.com)로 올린다.
      릴리스할 때만 켠다: mvn -Prelease deploy
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
